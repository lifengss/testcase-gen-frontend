# ============================================================================
# TestGen BFF 环境变量模板
# 复制为 .env 后按需填写；启动：AI_PROVIDER=codebuddy npm start
# （也可直接把变量写在启动命令行前，无需 .env 文件）
# ============================================================================

# ---- 服务与知识系统 ----
PORT=4123
# 知识系统（test-knowledge-system）基址，路径 B 入库/检索/图谱都走这里
KS_API_BASE=http://localhost:3000

# ---- AI 平台连接器（AI-Adapter） ----
# provider 可选：openai | codebuddy | none
#   openai    : 兼容 OpenAI 的 REST（豆包/火山方舟、腾讯 TokenHub、codebuddy2api）
#   codebuddy : 腾讯云 CodeBuddy Agent SDK（库调用，需已 npm i @tencent-ai/agent-sdk）
#   none      : 强制走本地模板兜底（离线/演示）
AI_PROVIDER=codebuddy

# 通用模型名（codebuddy 通道缺省为 claude-sonnet-4；openai 通道为真实模型/接入点 ID）
AI_MODEL=claude-sonnet-4

# ---- OpenAI 兼容通道（provider=openai 时生效） ----
# 豆包/火山方舟示例：
#   AI_ENDPOINT=https://ark.cn-beijing.volcesengine.com/api/v3/chat/completions
#   AI_API_KEY=<火山方舟 API Key>
#   AI_MODEL=ep-xxxxxx            # 推理接入点 ID，非模型名
# 腾讯 TokenHub 示例：
#   AI_ENDPOINT=https://tokenhub-intl.tencentcloudmaas.com/v1/chat/completions
#   AI_API_KEY=<TokenHub API Key>
#   AI_MODEL=deepseek-v4-pro
AI_ENDPOINT=
AI_API_KEY=

# ---- CodeBuddy 通道（provider=codebuddy 时生效） ----
# 获取地址（按版本）：
#   中国版   https://copilot.tencent.com/profile/   -> 国内版必须带下方 internal
#   国际版   https://www.codebuddy.ai/profile/keys  -> 不设置 INTERNET_ENVIRONMENT
#   iOA 版   https://tencent.sso.copilot.tencent.com/profile/keys -> ioa
CODEBUDDY_API_KEY=
# 国内版必填；国际版留空；iOA 版填 ioa
CODEBUDDY_INTERNET_ENVIRONMENT=internal

# 企业 OAuth（可选，替代 CODEBUDDY_API_KEY）：向 copilot.tencent.com/oauth2/token 换 token 后填入
# CODEBUDDY_AUTH_TOKEN=
